{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=wc-settings&tab=checkout&section=ramzpal",
  "login": true,
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.0"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "/wordpress/wp-content/plugins/ramzpal-payment-gateway-for-woocommerce/ramzpal-payment-gateway-for-woocommerce.php"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "woocommerce_currency": "USDT"
      }
    }
  ]
}
